{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "GHCi - Run Haskell",
            "type": "shell",
            "command": "ghci",
            "args": [
                "${fileDirname}/${fileBasenameNoExtension}.hs"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
